{
  "name": "byte-vue-monitor",
  "version": "0.2.0",
  "description": "Lifecycle-safe telemetry hooks for Vue 3",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "lib",
    "utils",
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --config vite.demo.config.js",
    "build": "vite build --config vite.sdk.config.js && vite build --config vite.demo.config.js",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include=lib/** --test-coverage-include=utils/** --test tests/*.test.js",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm test && npm run build && npm run test:e2e"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vite": "8.3.3",
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  }
}
